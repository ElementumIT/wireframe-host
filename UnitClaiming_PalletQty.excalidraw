      "link": null,
      "locked": false,
      "text": "⚠ Previous button DISABLED for Standard variation when:\n• Previous step was PartNumber (2) OR SerialNumber (3)\n• Ticket #84304 (7/3/2023, Wilbur Gingerich)\n• Helpdesk ticket 84304\n\nReason: prevent accidental qty changes after part/serial entered\n\nOther variations: Previous ENABLED",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "⚠ Previous button DISABLED for Standard variation when:\n• Previous step was PartNumber (2) OR SerialNumber (3)\n• Ticket #84304 (7/3/2023, Wilbur Gingerich)\n• Helpdesk ticket 84304\n\nReason: prevent accidental qty changes after part/serial entered\n\nOther variations: Previous ENABLED",
      "autoResize": true,
      "lineHeight": 1.4
    },
