      "link": null,
      "locked": false,
      "text": "Navigation:\n• Previous → back to Serial Number (enabled, except Standard from Part/Serial)\n• Next (Enter) → advances to GetSkidWeight (5)\n• Enter = Next, Esc = Previous\n• Saves SkidQuantity + ClaimedQuantity",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Navigation:\n• Previous → back to Serial Number (enabled, except Standard from Part/Serial)\n• Next (Enter) → advances to GetSkidWeight (5)\n• Enter = Next, Esc = Previous\n• Saves SkidQuantity + ClaimedQuantity",
