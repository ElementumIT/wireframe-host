      "updated": 0,
      "link": null,
      "locked": false,
      "text": "Combo Skid special:\n• After first skid qty → ComboSkidActiveSkidIndex = 1\n• Re-shows PartNumber for skid 2\n• Right panel shows both skids: \"Qty1 / Qty2\"\n• Right panel label changes to \"Pallet Qty\" (not Claimed Qty)\n• Previous enabled (no disable rule for combo)",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Combo Skid special:\n• After first skid qty → ComboSkidActiveSkidIndex = 1\n• Re-shows PartNumber for skid 2\n• Right panel shows both skids: \"Qty1 / Qty2\"\n• Right panel label changes to \"Pallet Qty\" (not Claimed Qty)\n• Previous enabled (no disable rule for combo)",
      "autoResize": true,
      "lineHeight": 1.4
    },
