      "seed": 1022,
      "version": 1,
      "versionNonce": 1022,
      "isDeleted": false,
      "boundElements": [],
      "updated": 0,
      "link": null,
      "locked": false,
      "text": "Navigation:\n• Previous → back to Employee Authorization\n• Next (Enter) → advances to GetSerialNumber\n• Enter key = Next (AcceptButton)\n• Esc = Previous (CancelButton)\n\nCombo skid special case:\n• When on skid 2 part number, Previous\n  is disabled if coming from skid 1 qty step",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Navigation:\n• Previous → back to Employee Authorization\n• Next (Enter) → advances to GetSerialNumber\n• Enter key = Next (AcceptButton)\n• Esc = Previous (CancelButton)\n\nCombo skid special case:\n• When on skid 2 part number, Previous\n  is disabled if coming from skid 1 qty step",
      "autoResize": true,
      "lineHeight": 1.4
    }
  ],
